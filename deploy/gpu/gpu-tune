#!/bin/bash
# EXAMPLE ONLY: Radeon Vega 56 undervolt/power settings, applied at boot by gpu-tune.service.
# These values were tuned for ONE specific card and are NOT safe defaults for yours. Adjust the PCI address (D=...)
# and every clock/voltage/power value for your own hardware and test carefully. Undo: systemctl disable --now gpu-tune && reboot
set -e
D=/sys/bus/pci/devices/0000:05:00.0; H=$(ls -d $D/hwmon/hwmon*)
# 1) PCIe power saving (ASPM) off along the whole CPU->GPU path
for dev in $(readlink -f $D | tr "/" "\n" | grep -E "^[0-9a-f]{4}:") 0000:05:00.1; do
  setpci -s $dev CAP_EXP+10.w=0000:0003
done
# 2) Factory clocks with every voltage 45 mV under factory.
#    factory: P5 1474/1100  P6 1569/1150  P7 1622/1200   HBM P3 800/950 (left as is)
#    Warning: too low a voltage can hang the GPU, so test before lowering voltages further.
echo manual > $D/power_dpm_force_performance_level
echo "s 5 1474 1055" > $D/pp_od_clk_voltage
echo "s 6 1569 1105" > $D/pp_od_clk_voltage
echo "s 7 1622 1155" > $D/pp_od_clk_voltage
echo c > $D/pp_od_clk_voltage
echo auto > $D/power_dpm_force_performance_level
# 3) Power limit 180 W (factory 150 W, card max 225 W).
echo 180000000 > $H/power1_cap
