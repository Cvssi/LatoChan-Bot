# /etc/latochan.env  (root:root, mode 600). Copy this file, fill it in, NEVER commit the real one.
DISCORD_BOT_TOKEN=
LLM_MODEL=
OWNER_ID=
CHANNEL_IDS=
MEMBERS_INTENT=1

# Optional. Set BOT_ID when using the reminder helper.
#BOT_ID=
#GUILD_ID=
#FRIEND_IDS=id1,id2
#BOT_NAME=latochan
#USER_NAME=owner
#TIMEZONE=UTC
#NUM_CTX=8192
#SLEEP_MODE=0

# Private notes/retrieval disabled until owner-only channels are explicitly approved.
PRIVATE_CHANNEL_IDS=
#RAG_ENABLED=0
#RAG_DIR=/var/lib/latochan/rag
#CONTENT_LOGS=0
#EMBED_URL=http://localhost:11434
#EMBED_MODEL=nomic-embed-text
#WU_API_KEY=
#WU_STATION=
#VOICE_TOKEN=
#PERSONA_PATH=/etc/latochan/persona.md
